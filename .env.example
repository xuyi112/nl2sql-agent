# ========== 环境变量模板 ==========
# 复制本文件为 .env 并填入真实值:
#   copy .env.example .env

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-你的真实APIKey填这里
# DeepSeek 兼容 OpenAI 协议,base_url 固定如下
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名:deepseek-chat 是对话模型(V4 系列),如与你账号不符可在 DeepSeek 开放平台查看
DEEPSEEK_MODEL=deepseek-v4-flash


